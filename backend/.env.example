# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///leads.db

# --- Email notifications (Gmail example: use an App Password, not your real password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFY_EMAIL=owner@chanduinteriors.com

# --- WhatsApp notifications via Twilio ---
# Sign up at https://www.twilio.com/whatsapp, get these from the console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFY_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# --- Admin panel login (visit /admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# --- CORS: your live website's domain, e.g. https://chanduinteriors.com ---
CORS_ORIGINS=*
